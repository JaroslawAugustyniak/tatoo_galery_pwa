UID=1000
GID=1000
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=tattoogallery
MYSQL_USER=tattoo
MYSQL_PASSWORD=change_me
# Podpis cookie sesji (min. 16 znaków): openssl rand -hex 32
SESSION_SECRET=change_me_session_secret
# true, gdy aplikacja stoi za HTTPS
COOKIE_SECURE=false
# Resend (https://resend.com) - wysyłka kodów 2FA i resetu hasła.
# Bez tych wartości w trybie dev kody trafiają do logów kontenera: docker logs tattoogallery_app
RESEND_API_KEY=
# Domena nadawcy musi być zweryfikowana w Resend, np. Tattoo Gallery <no-reply@twojadomena.pl>
MAIL_FROM=
