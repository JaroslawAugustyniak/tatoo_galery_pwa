# Plik .env na SERWERZE (obok docker-compose.server.yml). Nie commituj prawdziwych wartości.
APP_DOMAIN=tatoo.asapcreative.agency
# Sieć Dockera, w której działa Nginx Proxy Manager (docker inspect <kontener-npm>)
PROXY_NETWORK=nginx-proxy-manager_default

# Wspólna baza MySQL: nazwa jej KONTENERA i sieć Dockera, w której jest dostępna
DB_HOST=
DB_NETWORK=
DB_PORT=3306
MYSQL_DATABASE=tattoogallery
MYSQL_USER=tattoo
# openssl rand -hex 16  (bez znaków specjalnych - hasło trafia do URL-a)
MYSQL_PASSWORD=

# openssl rand -hex 32
SESSION_SECRET=

# Resend: domena nadawcy musi być zweryfikowana
RESEND_API_KEY=
MAIL_FROM=Tattoo Gallery <no-reply@twojadomena.pl>
